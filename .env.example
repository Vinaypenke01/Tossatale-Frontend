# Tossatale Frontend — Environment Configuration Template
# API Base URL for backend Django REST endpoints
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Application details
VITE_APP_NAME=tossatale
VITE_APP_ENV=development

# Site Maintenance / Under Construction Toggle
# Set to 'true' to display the dedicated Under Construction page instead of the homepage.
# Set to 'false' for normal site operation.
VITE_UNDER_CONSTRUCTION=false
